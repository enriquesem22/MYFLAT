# Credenciales de Supabase (opcionales).
# Copia este archivo como ".env" para desarrollo local con backend real.
# Si no las defines, Myflat funciona en modo demo (datos locales).
#
# Las encuentras en tu proyecto de Supabase -> Project Settings -> API.
# La anon key es PÚBLICA por diseño (protegida por RLS): nunca uses la
# service_role aquí.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY
